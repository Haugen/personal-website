---
import FontPreloads from "../components/FontPreloads.astro";
import "../styles/global.css";
---

<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <FontPreloads />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Sidan finns inte · Tobias Haugen</title>
  </head>
  <body class="bg-white font-serif text-ink antialiased">
    <main class="mx-auto grid max-w-[620px] gap-5 px-5 pt-10 pb-20 sm:max-w-[740px] sm:gap-6 sm:pt-14 lg:pt-28">
      <p class="font-sans text-[13px] font-semibold sm:text-[15px]">404</p>
      <h1 class="font-sans text-[32px] leading-[1.08] font-bold tracking-[-0.035em] text-balance sm:text-[48px]">
        Sidan finns inte längre.
      </h1>
      <p class="text-[19.5px] leading-[1.62] sm:text-[21px]">
        Sajten har byggts om och en del gammalt innehåll är borttaget.
        <a href="/" class="underline decoration-rule underline-offset-4 hover:decoration-ink">Till startsidan</a>
      </p>
    </main>
  </body>
</html>
