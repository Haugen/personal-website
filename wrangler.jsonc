// Cloudflare Workers config: the site is fully static, so the Worker only serves the built files in dist/.
// Workers Builds runs `pnpm build` and then `npx wrangler deploy` on every push to main.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-website",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Served only on www; tobiashaugen.se → www is a Redirect Rule in the zone, not part of the Worker.
  // Every deploy applies these, so the dashboard can't drift from them.
  "routes": [{ "pattern": "www.tobiashaugen.se", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
